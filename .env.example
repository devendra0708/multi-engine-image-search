# ──────────────────────────────────────────────────
# Google Custom Search
# ──────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Enable "Custom Search API"
# 3. Create an API key
# 4. Go to https://programmablesearchengine.google.com/
# 5. Create a search engine with "Search the entire web" enabled
# 6. Copy the CX (Search engine ID)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CX=your_google_cx_here

# ──────────────────────────────────────────────────
# Bing Image Search (Azure Cognitive Services)
# ──────────────────────────────────────────────────
# 1. Go to https://portal.azure.com/
# 2. Create a "Bing Search v7" resource (free tier available)
# 3. Copy either Key1 or Key2 from "Keys and Endpoint"
BING_API_KEY=your_bing_api_key_here

# ──────────────────────────────────────────────────
# Unsplash
# ──────────────────────────────────────────────────
# 1. Go to https://unsplash.com/developers
# 2. Click "Your apps" → "New Application"
# 3. Accept the API guidelines
# 4. Copy the "Access Key" (not the Secret Key)
# Free tier: 50 requests/hour (Demo), 5000/hour after production approval
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# ──────────────────────────────────────────────────
# Pexels
# ──────────────────────────────────────────────────
# 1. Go to https://www.pexels.com/api/
# 2. Sign up / log in and click "Get Started"
# 3. Copy your API key from the dashboard
# Free tier: 200 requests/hour, 20,000/month
PEXELS_API_KEY=your_pexels_api_key_here

# ──────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────
PORT=3000
